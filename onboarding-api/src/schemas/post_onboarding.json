{
  "title": "PostOnboarding",
  "description": "RFC 05, POST /onboarding. PF manda birth_date e occupation; PJ manda opening_date. Campo de um tipo no outro e recusado: so se coleta o necessario.",
  "type": "object",
  "properties": {
    "type": {
      "enum": ["PF", "PJ"]
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "\\S"
    },
    "document_number": {
      "type": "string",
      "maxLength": 18
    },
    "birth_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "opening_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "declared_monthly_income_cents": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000000000000
    },
    "occupation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "\\S"
    },
    "pep_self_declared": {
      "type": "boolean"
    }
  },
  "required": [
    "type",
    "name",
    "document_number",
    "declared_monthly_income_cents",
    "pep_self_declared"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": { "type": { "const": "PF" } },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "document_number": { "pattern": "^\\d{3}\\.\\d{3}\\.\\d{3}-\\d{2}$" },
          "opening_date": false
        },
        "required": ["birth_date", "occupation"]
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "PJ" } },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "document_number": { "pattern": "^\\d{2}\\.\\d{3}\\.\\d{3}/\\d{4}-\\d{2}$" },
          "birth_date": false,
          "occupation": false
        },
        "required": ["opening_date"]
      }
    }
  ]
}
